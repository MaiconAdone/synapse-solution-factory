{
  "mcpServers": {
    "ruflo": {
      "command": "cmd",
      "args": [
        "/c",
        "npm",
        "exec",
        "--",
        "ruflo",
        "mcp",
        "start"
      ],
      "env": {
        "npm_config_update_notifier": "false",

        "CLAUDE_FLOW_MODE": "v3",
        "CLAUDE_FLOW_HOOKS_ENABLED": "true",
        "CLAUDE_FLOW_TOPOLOGY": "hierarchical-mesh",
        "CLAUDE_FLOW_MAX_AGENTS": "60",
        "CLAUDE_FLOW_MEMORY_BACKEND": "hybrid",
        "SYNAPSE_MODEL_ROUTING": "governed_local_first",
        "SYNAPSE_GOVERNANCE_ENABLED": "true",
        "SYNAPSE_ALLOW_CLOUD_DEFAULT": "false",
        "OLLAMA_BASE_URL": "http://127.0.0.1:11434",
        "OLLAMA_MODEL": "qwen2.5-coder:3b",
        "OLLAMA_BALANCED_MODEL": "deepseek-coder-v2:lite",
        "OLLAMA_CODE_REVIEW_MODEL": "deepseek-coder-v2:lite",
        "OLLAMA_LARGE_MODEL": "deepseek-coder-v2:lite",

        "OPENAI_PROVIDER": "openai",
        "OPENAI_MODEL": "gpt-5.5",
        "CODEX_PROVIDER": "openai",
        "CODEX_MODEL": "gpt-5.5",

        "OPENAI_API_KEY": "${env:OPENAI_API_KEY}"
      },
      "autoStart": true
    },
    "synapse-peers": {
      "command": "python",
      "args": [
        "scripts/synapse_peers_mcp.py"
      ],
      "env": {
        "SYNAPSE_PEER_TYPE": "codex",
        "PEER_MESSAGING_DB_PATH": "./artifacts/peers/synapse-peers.db",
        "PEER_MESSAGING_MAX_MESSAGE_CHARS": "1200",
        "PEER_MESSAGING_MAX_SUMMARY_CHARS": "360"
      },
      "autoStart": false
    },
    "claude-peers": {
      "command": "C:\\Users\\malves\\.bun\\bin\\bun.exe",
      "args": [
        "C:\\Users\\malves\\.claude\\mcp\\claude-peers-mcp\\server.ts"
      ],
      "env": {
        "CLAUDE_PEERS_PORT": "7899",
        "CLAUDE_PEERS_DB": "C:/Users/malves/.claude-peers.db",
        "HOME": "C:/Users/malves",
        "OPENAI_API_KEY": ""
      },
      "autoStart": false
    }
  }
}
