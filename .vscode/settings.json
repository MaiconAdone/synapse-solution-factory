{
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.next": true,
    "**/node_modules": true,
    "**/.adonex/index": true,
    "**/.adonex/tasks": true,
    "**/.adonex/cache": true,
    "**/.adonex/memory/archive": true,
    "**/.adonex-backup": true,
    "**/.cache": true,
    "**/.claude-flow": true,
    "**/.swarm": true,
    "**/artifacts/mlflow": true,
    "**/logs": true,
    "**/output": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/.next/**": true,
    "**/node_modules/**": true,
    "**/.venv/**": true,
    "**/.adonex/index/**": true,
    "**/.adonex/tasks/**": true,
    "**/.adonex/cache/**": true,
    "**/.adonex/memory/archive/**": true,
    "**/.adonex-backup/**": true,
    "**/.cache/**": true,
    "**/.claude-flow/**": true,
    "**/.swarm/**": true,
    "**/artifacts/**": true,
    "**/data/**": true,
    "**/logs/**": true,
    "**/output/**": true,
    "**/vector_db/**": true
  },
  "search.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.next": true,
    "**/node_modules": true,
    "**/.venv": true,
    "**/.adonex/index": true,
    "**/.adonex/tasks": true,
    "**/.adonex/cache": true,
    "**/.adonex/memory/archive": true,
    "**/.adonex-backup": true,
    "**/.cache": true,
    "**/.claude-flow": true,
    "**/.swarm": true,
    "**/artifacts": true,
    "**/data": true,
    "**/logs": true,
    "**/output": true,
    "**/vector_db": true
  },
  "python.analysis.extraPaths": ["${workspaceFolder}/backend"],
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "powershell.scriptAnalysis.enable": true,
  "task.allowAutomaticTasks": "on",
  "adonex.voice.startWithVSCode": false,
  "adonex.voice.autoOpenCockpit": false,
  "adonex.voice.wakeWord": "Vick",
  "adonex.voice.engine": "local_service",
  "adonex.voice.localServiceUrl": "http://127.0.0.1:8765",
  "adonex.patch.applyMode": "prepare",
  "adonex.voice.requireConfirmationForPatch": true,
  "adonex.security.requireApprovalBeforeWrite": true,
  "adonex.security.requireApprovalBeforeCommand": true,
  "adonex.synapse.autonomous": false
}



