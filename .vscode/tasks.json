{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "projectName",
      "type": "promptString",
      "description": "Nome do novo projeto IA/ML"
    },
    {
      "id": "projectType",
      "type": "pickString",
      "description": "Universo do projeto",
      "options": [
        "ML",
        "IA",
        "ML + IA (Hibrido)",
        "Chatbolt"
      ],
      "default": "ML + IA (Hibrido)"
    },
    {
      "id": "projectGoal",
      "type": "promptString",
      "description": "Objetivo do projeto"
    },
    {
      "id": "businessProblem",
      "type": "promptString",
      "description": "Problema de negocio que o projeto precisa resolver"
    },
    {
      "id": "successMetric",
      "type": "promptString",
      "description": "Metrica de sucesso ou criterio de aceite (ex.: 80% dos casos resolvidos sem humano)"
    },
    {
      "id": "availableSources",
      "type": "promptString",
      "description": "Dados, documentos ou fontes disponiveis (ex.: FAQ, CSV de vendas, API de pedidos)"
    },
    {
      "id": "riskLevel",
      "type": "pickString",
      "description": "Nivel de risco da solucao",
      "options": [
        "baixo",
        "medio",
        "alto",
        "critico"
      ]
    },
    {
      "id": "dataFile",
      "type": "promptString",
      "description": "Arquivo para tratar (ex.: data/raw/clientes.csv)"
    },
    {
      "id": "attachmentPath",
      "type": "promptString",
      "description": "Foto ou arquivo para anexar ao projeto (caminho completo ou relativo)"
    },
    {
      "id": "contextFile",
      "type": "promptString",
      "description": "Arquivo grande para filtrar antes de enviar ao LLM"
    }
  ],
  "tasks": [
    {
      "label": "Synapse: Market Radar + Context Filter",
      "detail": "Busca sinais em HN Show/Product Hunt, classifica oportunidades para o Synapse e gera relatorio com contexto filtrado.",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "python ${workspaceFolder}\\scripts\\market_radar.py"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true
      }
    },
    {
      "label": "Synapse: Filtrar contexto para LLM",
      "detail": "Remove ruido, duplicacao e excesso de contexto para reduzir tokens antes de acionar OpenAI ou Anthropic.",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "python ${workspaceFolder}\\scripts\\context_filter.py --input \"${input:contextFile}\" --output ${workspaceFolder}\\output\\context_filter\\filtered_context.txt --max-chars 12000"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true
      }
    },
    {
      "label": "AI Factory: Criar projeto com Codex + tratamento dados",
      "detail": "Cria projeto com contexto economico para Codex e inclui tratamento de dados.",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\create_ai_project.ps1",
        "-NomeProjeto",
        "${input:projectName}",
        "-TipoProjeto",
        "${input:projectType}",
        "-ProjectGoal",
        "${input:projectGoal}",
        "-BusinessProblem",
        "${input:businessProblem}",
        "-SuccessMetric",
        "${input:successMetric}",
        "-AvailableSources",
        "${input:availableSources}",
        "-RiskLevel",
        "${input:riskLevel}"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true
      }
    },
    {
      "label": "AI Factory: Anexar foto ou arquivo ao projeto",
      "detail": "Copia uma foto ou arquivo para o projeto criado e registra manifesto para Codex e o pool de agentes.",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\import_project_file.ps1",
        "-ProjectName",
        "${input:projectName}",
        "-InputPath",
        "${input:attachmentPath}"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true
      }
    },
    {
      "label": "Synapse: Diagnosticar projeto criado",
      "detail": "Audita um projeto criado pelo Synapse e valida universo, governanca de agentes, tratamento de dados, anexos e frameworks IA quando aplicavel.",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\diagnose_project.ps1",
        "-ProjectName",
        "${input:projectName}"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true
      }
    },
    {
      "label": "AI Factory: Menu interativo",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\ai_factory_menu.ps1"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Enterprise: Validar stack",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\validate_enterprise_stack.ps1"
      ],
      "group": "test",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Enterprise: Bootstrap sem servidores",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\bootstrap_enterprise_stack.ps1"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Codex: Tratar dados",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\codex_data_treatment_dialog.ps1",
        "-InputPath",
        "${input:dataFile}"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true
      }
    },
    {
      "label": "Dados: Tratar dataset estatistico",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "python ${workspaceFolder}\\scripts\\treat_dataset.py --input \"${input:dataFile}\""
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true
      }
    },
    {
      "label": "Evals: Rodar testes ML",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\run_ml_evals.ps1"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Evals: Rodar testes IA",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\run_ai_evals.ps1"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Evals: Rodar testes RAG",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\run_rag_evals.ps1"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Synapse: Preparar runtime VS Code",
      "dependsOn": [
        "Enterprise: Validar stack"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "Abrir: Runtime Manifest",
      "type": "shell",
      "command": "code",
      "args": [
        "${workspaceFolder}\\config\\runtime_manifest.json"
      ],
      "problemMatcher": []
    },
    {
      "label": "Abrir: Papeis dos Workflows",
      "type": "shell",
      "command": "code",
      "args": [
        "${workspaceFolder}\\config\\roles.json"
      ],
      "problemMatcher": []
    },
    {
      "label": "Abrir: Workflows Enterprise",
      "type": "shell",
      "command": "code",
      "args": [
        "${workspaceFolder}\\config\\workflows\\enterprise_workflows.yaml"
      ],
      "problemMatcher": []
    },
    {
      "label": "Evals: Rodar retrieval hibrido (recall@k, MRR, nDCG)",
      "detail": "Indexa o corpus local com busca hibrida e aplica os gates de retrieval.",
      "type": "shell",
      "command": "python",
      "args": [
        "scripts/run_evals.py",
        "retrieval"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Synapse: Auditar harness engineering",
      "detail": "Verifica os componentes de harness para cada universo.",
      "type": "shell",
      "command": "python",
      "args": [
        "scripts/audit_harness.py",
        "--universe",
        "hybrid"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Synapse: Casos de transformacao empresarial",
      "detail": "Roda os casos de risco, autonomia e aprovacao do motor empresarial.",
      "type": "shell",
      "command": "python",
      "args": [
        "scripts/run_business_transformation.py",
        "--cases",
        "evals/business_transformation_cases.jsonl"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Synapse: Checar registro de livros",
      "detail": "Confere se implementation_map e a spec enterprise estao sincronizados com config/book_registry.json.",
      "type": "shell",
      "command": "python",
      "args": [
        "scripts/sync_book_registry.py",
        "--check"
      ],
      "group": "test",
      "problemMatcher": []
    }
  ]
}
