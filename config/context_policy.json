{
  "id": "synapse-context-policy",
  "version": "1.0.0",
  "purpose": "Reduce noisy workspace content before LLM, Ruflo, Codex, Claude, and AdoneX calls.",
  "max_chars": {
    "simple": 4000,
    "standard": 12000,
    "architecture": 24000,
    "hard_limit": 42000
  },
  "ignored_directories": [
    ".adonex",
    ".cache",
    ".claude",
    ".claude-flow",
    ".codex",
    ".git",
    ".next",
    ".pytest_cache",
    ".ruff_cache",
    ".swarm",
    ".venv",
    ".vscode-test",
    "__pycache__",
    "artifacts",
    "build",
    "coverage",
    "dist",
    "frontend/.next",
    "logs",
    "node_modules",
    "output",
    "tmp"
  ],
  "ignored_file_globs": [
    "*.7z",
    "*.bin",
    "*.db",
    "*.dll",
    "*.exe",
    "*.gif",
    "*.jpg",
    "*.jpeg",
    "*.lock",
    "*.log",
    "*.map",
    "*.mp4",
    "*.parquet",
    "*.pdf",
    "*.png",
    "*.pyc",
    "*.pyo",
    "*.sqlite",
    "*.sst",
    "*.vsix",
    "*.wasm",
    "*.xlsx",
    "*.zip",
    "package-lock.json"
  ],
  "sensitive_file_globs": [
    ".env",
    ".env.*",
    "*.key",
    "*.pem",
    "*credentials*",
    "*secret*"
  ],
  "keep_file_globs": [
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    ".mcp.json",
    "config/runtime_manifest.json",
    "config/context_policy.json",
    "config/model_providers.json",
    "config/cost_optimization_policy.json",
    "scripts/*.py",
    "scripts/*.ps1",
    "backend/app/**/*.py",
    "tests/**/*.py",
    "prompts/*.md",
    "docs/**/*.md"
  ],
  "line_noise_patterns": [
    "^\\s*$",
    "^\\s*(DEBUG|TRACE)\\b",
    "^\\s*(at\\s+[\\w.$<>]+\\(|File\\s+\\\".+\\\", line \\d+)",
    "^[A-Za-z0-9+/]{120,}={0,2}$"
  ],
  "line_keep_patterns": [
    "\\b(error|failed|exception|traceback|assert|warning)\\b",
    "\\b(todo|fixme|security|cost|token|agent|rag|mcp|mlflow|gateway)\\b",
    "^\\s*(def|class|function|param|import|from|export|type|interface)\\b",
    "^\\s*[-*]\\s+"
  ]
}
