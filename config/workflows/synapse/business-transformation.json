{
  "name": "business-transformation",
  "description": "Diagnose, redesign, govern and measure an enterprise process with agentic AI.",
  "execution": {
    "mode": "stateful-governed",
    "coordination": "orchestration-manager",
    "simulationFirst": true,
    "humanApprovalFor": [
      "HIGH",
      "CRITICAL"
    ],
    "functionalAgentProfiles": "agents/definitions/business_transformation_agents.yaml",
    "contract": "config/business_transformation.json",
    "engine": "scripts/synapse_lib/business_transformation.py"
  },
  "steps": [
    {"name": "intake", "role": "orchestration-manager", "profile": "orchestrator"},
    {"name": "diagnosis", "role": "product-strategy", "profile": "business-transformation"},
    {"name": "process_mapping", "role": "business-value-analyst", "profile": "process-mapping"},
    {"name": "data_readiness", "role": "data-science", "profile": "data-analysis"},
    {"name": "opportunity_identification", "role": "product-strategy", "profile": "business-transformation", "supporting_roles": ["llm-engineering"]},
    {"name": "prioritization", "role": "product-strategy", "profile": "business-transformation"},
    {"name": "automation_architecture", "role": "integration-automation", "profile": "automation-architect"},
    {"name": "kpi_design", "role": "metrics-instrumentation", "profile": "kpi-monitor"},
    {"name": "execution_planning", "role": "orchestration-manager", "profile": "orchestrator"},
    {"name": "risk_governance", "role": "security-compliance", "profile": "risk-governance"},
    {"name": "human_approval", "role": "policy-guardrails-engineer", "profile": "human-approval"},
    {"name": "simulation", "role": "integration-automation", "profile": "automation-architect", "supporting_roles": ["testing-qa"]},
    {"name": "impact_evaluation", "role": "metrics-instrumentation", "profile": "kpi-monitor", "supporting_roles": ["business-value-analyst"]},
    {"name": "final_report", "role": "orchestration-manager", "profile": "orchestrator", "supporting_roles": ["documentation"]}
  ]
}
