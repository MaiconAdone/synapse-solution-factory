{
  "name": "rag-build",
  "description": "Build, evaluate, and publish a RAG knowledge base.",
  "policy": "config/rag_scalability_policy.json",
  "executable_pipeline": {
    "evaluate_and_stage": "python scripts/synapse_ci.py pipeline",
    "switch_index_alias": "python scripts/synapse_ci.py promote --env prod --approver <aprovador>"
  },
  "steps": [
    {"name": "confirm_scale_decisions", "role": "rag-engineering"},
    {"name": "ingest_sources", "role": "data-engineering"},
    {"name": "validate_documents", "role": "data-engineering"},
    {"name": "redact_sensitive_content", "role": "security-compliance"},
    {"name": "chunk_documents", "role": "rag-engineering"},
    {"name": "generate_embeddings", "role": "rag-engineering"},
    {"name": "build_versioned_vector_index", "role": "rag-engineering"},
    {"name": "evaluate_retrieval", "role": "testing-qa"},
    {"name": "switch_index_alias", "role": "rag-engineering"}
  ]
}
