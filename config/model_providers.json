{
  "llm_gateway": {
    "enabled": true,
    "entrypoint": "backend/app/services/llm_gateway.py",
    "public_routes": [
      "/hybrid-llm/generate",
      "/hybrid-llm/decision",
      "/swarm"
    ],
    "all_generation_must_pass_gateway": true,
    "cache_path_env": "LLM_GATEWAY_CACHE_PATH",
    "audit_path_env": "LLM_GATEWAY_AUDIT_PATH",
    "max_input_tokens_env": "LLM_GATEWAY_MAX_INPUT_TOKENS",
    "daily_cloud_token_budget_env": "LLM_GATEWAY_DAILY_CLOUD_TOKEN_BUDGET",
    "per_request_cloud_token_budget_env": "LLM_GATEWAY_PER_REQUEST_CLOUD_TOKEN_BUDGET"
  },
  "routing_strategy": "assistant_boundaries",
  "swarm_bridge": {
    "enabled": true,
    "status_service": "backend/app/services/swarm_service.py",
    "all_60_agents_have_governed_router_access": true,
    "single_consolidated_call_by_default": true
  },
  "continual_learning": {
    "mode": "project_scoped_retrieval_augmented_learning",
    "capture_from": "llm_gateway",
    "human_feedback_tool": "approve_learning_example",
    "automatic_weight_updates": false,
    "future_specialization": "LoRA_or_adapter_only_after_evals"
  },
  "automatic_routing": {
    "default": "openai",
    "cloud_default_enabled": true,
    "cloud_requires_human_approval": false,
    "human_approval_required_for": "activate_all_60_agents",
    "sensitive_content_blocked": true,
    "metrics": [
      "latency_ms",
      "prompt_tokens",
      "completion_tokens",
      "provider",
      "retried",
      "quality_passed"
    ]
  },
  "providers": {
    "openai": {
      "enabled_when_configured": true,
      "role": "primary_generation_provider",
      "default_model_env": "OPENAI_MODEL",
      "default_model": "gpt-5.5",
      "use_cases": [
        "project_planning",
        "code_generation",
        "agent_blueprints",
        "context_summarization",
        "data_analysis_assistance",
        "high_complexity_reasoning",
        "managed_tool_calling"
      ]
    },
    "anthropic": {
      "enabled_when_configured": true,
      "fallback_for": [
        "claude_code_direct"
      ]
    }
  },
  "guardrails": {
    "do_not_send_secrets_to_external_providers": true,
    "require_evaluation_before_provider_promotion": true,
    "activate_multiple_paid_agents_only_when_justified": true
  },
  "assistant_provider_boundaries": {
    "codex": {
      "provider": "openai",
      "direct_generation": true
    },
    "claude_code": {
      "provider": "anthropic",
      "direct_generation": true
    }
  }
}
