{
  "project": {
    "name": "synapse-ai",
    "type": "enterprise-ai-ml-saas",
    "core": "codex-claude"
  },
  "agent_governance": {
    "enabled": true,
    "governance_policy_file": "config/harness_engineering_policy.json",
    "agent_blueprint_contract_file": "config/agent_blueprint_contract.json",
    "architectural_patterns_file": "config/agentic_architectural_patterns.json",
    "improvement_loop_file": "config/agent_improvement_loop.json",
    "roles_file": "config/roles.json",
    "execution": "single_assistant_first"
  },
  "agentic_architectural_patterns": {
    "enabled": true,
    "catalog_file": "config/agentic_architectural_patterns.json",
    "docs_file": "docs/architecture/agentic-architectural-patterns.md",
    "patterns": [
      "orchestrator-specialist",
      "critic-reviewer-gate",
      "a2a-message-contract",
      "tool-gateway",
      "model-router",
      "shared-memory-retrieval",
      "lifecycle-callbacks"
    ],
    "generated_projects_inherit": true
  },
  "mcp": {
    "server": "none",
    "transport": "stdio",
    "config_file": ".mcp.json",
    "peer_messaging_server": "synapse-peers",
    "peer_messaging_script": "scripts/synapse_peers_mcp.py",
    "peer_messaging_transport": "stdio",
    "peer_messaging_autostart": false
  },
  "cost_optimization": {
    "enabled": true,
    "policy_file": "config/cost_optimization_policy.json",
    "prefer_prompt_cache": true,
    "prefer_semantic_cache": true,
    "compress_context_before_llm": true,
    "send_only_role_specific_context": true
  },
  "local_llm": {
    "enabled": false,
    "provider": "openai",
    "routing_strategy": "cloud_only",
    "default_model": "gpt-5.5",
    "provider_config_file": "config/model_providers.json",
    "sensitive_content_blocked": true,
    "cloud_default_enabled": true,
    "cloud_requires_human_approval": false,
    "default_max_output_tokens": 512,
    "default_temperature": 0.0
  },
  "continual_learning": {
    "enabled": true,
    "mode": "memory_retrieval_first",
    "automatic_weight_updates": false,
    "events_path": "memory/synapse_learning_memory.jsonl",
    "training_dataset_path": "data/learning/training_examples.jsonl",
    "promotion_requires_evals_and_human_approval": true
  },
  "fine_tuning": {
    "enabled": true,
    "policy_file": "config/fine_tuning_policy.json",
    "spec_file": "docs/specifications/fine_tuning.md",
    "dataset_cli": "scripts/prepare_fine_tuning_dataset.py",
    "automatic_weight_updates": false,
    "requires_baseline_evals_and_human_approval": true
  },
  "harness_engineering": {
    "enabled": true,
    "policy_file": "config/harness_engineering_policy.json",
    "spec_file": "docs/specifications/harness_engineering.md",
    "audit_cli": "scripts/audit_harness.py",
    "reliability_metric": "pass_hat_k"
  },
  "business_transformation": {
    "enabled": true,
    "config_file": "config/business_transformation.json",
    "prompt_file": "prompts/business_transformation.md",
    "workflow_file": "config/workflows/synapse/business-transformation.json",
    "agent_profiles_file": "agents/definitions/business_transformation_agents.yaml",
    "engine": "scripts/synapse_lib/business_transformation.py",
    "cli": "scripts/run_business_transformation.py",
    "eval_cases": "evals/business_transformation_cases.jsonl",
    "brief_template": "templates/business/transformation_brief.json",
    "simulation_first": true,
    "human_approval_levels": [
      "HIGH",
      "CRITICAL"
    ],
    "inherited_by_generated_projects": true
  },
  "memory": {
    "enabled": true,
    "namespace": "synapse-ai",
    "persist_on_create": true,
    "runtime_file": "memory/project_memory.runtime.json",
    "peer_messaging_server": "synapse-peers",
    "shared_by": [
      "vscode-chat",
      "codex",
      "claude-code"
    ],
    "backend": "hybrid",
    "tiers": [
      "working",
      "episodic",
      "semantic"
    ],
    "embeddings": {
      "enabled": true,
      "dimension": 384,
      "provider": "local"
    },
    "semantic_search": {
      "enabled": true,
      "index": "hnsw-ready"
    },
    "vector_db_path": "vector_db"
  },
  "assistant_channels": {
    "enabled": true,
    "authorized_user_request_channels": [
      "VS Code Chat",
      "Claude Code",
      "Codex"
    ],
    "content_collection_rule": "Goals, constraints, files, decisions, approvals and missing briefing fields for corporate solution creation must be collected or confirmed through assistant chat channels before using tasks, scripts or tools.",
    "shared_solution_factory_access": {
      "policy": "config/llm_solution_factory_policy.json",
      "technology_catalog": "config/ai_framework_selection.json",
      "business_analyzer": "scripts/synapse_lib/business_solution_analyzer.py",
      "analyzer_cli": "scripts/analyze_business_solution.py",
      "governance": "docs/specifications/llm_solution_factory_governance.md",
      "technology_layer": "docs/specifications/technology_layer.md",
      "ml_foundations_policy": "config/ml_foundations_policy.json",
      "ml_foundations_spec": "docs/specifications/ml_foundations.md",
      "peer_mailbox": "synapse-peers",
      "tests": "tests",
      "evals": "evals"
    },
    "non_primary_channels": [
      "VS Code tasks",
      "scripts",
      "MCP tools"
    ],
    "non_primary_channel_rule": "Use non-primary channels only as execution, validation, scaffolding or tool shortcuts after chat has collected or confirmed the required user content."
  },
  "rag": {
    "ready": true,
    "implementation_status": "reference_implementation_local",
    "scalability_policy_file": "config/rag_scalability_policy.json",
    "spec_file": "docs/specifications/scalable_rag_vector_db.md",
    "reference_modules": [
      "scripts/synapse_lib/vector_store.py",
      "scripts/synapse_lib/rag_retrieval.py",
      "scripts/synapse_lib/rag_scalability.py"
    ],
    "retrieval_eval_command": "python scripts/run_evals.py retrieval",
    "limitations": [
      "the local hashing embedder is lexical, intended for bootstrap, offline evaluation and contract tests",
      "production vector stores plug in through the VectorStore protocol (templates/rag/vector_db_adapter.py)",
      "GraphRAG remains a governed advanced strategy, not the default retrieval path"
    ],
    "advanced_strategies": [
      "multi_query_retrieval",
      "hybrid_search",
      "semantic_search",
      "reranking",
      "context_compression",
      "parent_child_retrieval",
      "graph_rag",
      "metadata_filtering"
    ],
    "pipeline": [
      "ingest",
      "normalize",
      "chunk",
      "embed",
      "index",
      "retrieve",
      "rerank",
      "cite"
    ]
  },
  "engineering_practices": {
    "playbooks_path": "playbooks",
    "prompt_registry_path": "prompts",
    "evals_path": "evals",
    "llm_ops_path": "llm_ops",
    "ml_systems_path": "ml_systems",
    "rag_pipelines_path": "rag_pipelines",
    "guardrails_path": "guardrails",
    "foundations_notebooks_path": "notebooks/foundations",
    "book_map": "docs/books/implementation_map.md"
  },
  "validation": {
    "required_workflows": [
      "new-ai-project",
      "agent-build",
      "rag-build",
      "ml-release",
      "business-transformation"
    ],
    "required_practice_paths": [
      "config/ai_ml_enterprise_spec.json",
      "config/ai_framework_selection.json",
      "config/cost_optimization_policy.json",
      "config/model_providers.json",
      "config/context_policy.json",
      "config/roles.json",
      "config/agent_blueprint_contract.json",
      "config/agentic_architectural_patterns.json",
      "config/agent_improvement_loop.json",
      "config/llm_solution_factory_policy.json",
      "config/ml_foundations_policy.json",
      "config/business_solution_catalog.json",
      "config/business_transformation.json",
      "config/rag_scalability_policy.json",
      "config/fine_tuning_policy.json",
      "config/harness_engineering_policy.json",
      "docs/specifications/scalable_rag_vector_db.md",
      "docs/specifications/fine_tuning.md",
      "docs/specifications/harness_engineering.md",
      "evals/retrieval_cases.jsonl",
      "evals/tool_workflow_cases.jsonl",
      "docs/specifications/llm_solution_factory_governance.md",
      "docs/specifications/technology_layer.md",
      "docs/specifications/ml_foundations.md",
      "docs/radar/README.md",
      "docs/architecture/agentic-architectural-patterns.md",
      "notebooks/foundations/foundations_lab.ipynb",
      "playbooks/ai_engineering.md",
      "playbooks/prompt_engineering.md",
      "playbooks/llm_engineering.md",
      "playbooks/ml_systems.md",
      "playbooks/production_llms.md",
      "playbooks/math_for_ml.md",
      "playbooks/agentic_coding.md",
      "prompts/system_orchestration_manager.md",
      "prompts/master_data_treatment.md",
      "prompts/codex_data_treatment_dialog.md",
      "prompts/business_transformation.md",
      "config/data_treatment_policy.json",
      "evals/quality_gates.yaml",
      "llm_ops/observability.yaml",
      "ml_systems/data_contract.yaml",
      "rag_pipelines/pipeline.yaml",
      "guardrails/policy.yaml",
      "docs/books/implementation_map.md",
      "scripts/context_filter.py",
      "scripts/market_radar.py",
      "scripts/analyze_business_solution.py",
      "agents/definitions/business_transformation_agents.yaml",
      "config/workflows/synapse/business-transformation.json",
      "docs/AGENTIC_AI_TRANSFORMATION.md",
      ".codex/config.toml"
    ]
  },
  "assistant_provider_boundaries": {
    "codex": {
      "provider": "openai",
      "direct_generation": true
    },
    "claude_code": {
      "provider": "anthropic",
      "direct_generation": true
    }
  }
}
