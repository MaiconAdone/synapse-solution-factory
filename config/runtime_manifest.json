  "assistant_provider_boundaries": {
    "codex": {
      "provider": "openai",
      "direct_generation": true,
      "ollama_allowed": false
    },
    "claude_code": {
      "provider": "anthropic",
      "direct_generation": true,
      "ollama_allowed": false
    },
    "adonex": {
      "provider": "ollama",
      "exclusive": true,
      "cloud_allowed": false
    }
