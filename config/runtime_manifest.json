{
  "project": {
    "name": "synapse-ai",
    "type": "enterprise-ai-ml-saas",
    "core": "codex-ruflo"
  },
  "agentic_mesh": {
    "enabled": true,
    "trust_framework_file": "config/agent_trust_framework.json",
    "fleets_file": "config/agent_fleets.json",
    "agent_blueprint_contract_file": "config/agent_blueprint_contract.json",
    "architectural_patterns_file": "config/agentic_architectural_patterns.json",
    "improvement_loop_file": "config/agent_improvement_loop.json",
    "trust_layers": 7,
    "fleet_count": 7,
    "human_approval_required_for_all_60_agents": true
  },
  "agentic_architectural_patterns": {
    "enabled": true,
    "catalog_file": "config/agentic_architectural_patterns.json",
    "docs_file": "docs/architecture/agentic-architectural-patterns.md",
    "patterns": [
      "orchestrator-specialist",
      "critic-reviewer-gate",
      "a2a-message-contract",
      "tool-gateway",
      "model-router",
      "shared-memory-retrieval",
      "lifecycle-callbacks"
    ],
    "generated_projects_inherit": true
  },
  "mcp": {
    "server": "ruflo",
    "transport": "stdio",
    "config_file": ".mcp.json",
    "peer_messaging_server": "synapse-peers",
    "peer_messaging_script": "scripts/synapse_peers_mcp.py",
    "peer_messaging_transport": "stdio",
    "peer_messaging_autostart": false
  },
  "swarm": {
    "name": "synapse-ai-swarm",
    "topology": "hierarchical-mesh",
    "strategy": "specialized",
    "max_agents": 60,
    "core_agent_count": 15,
    "specialist_agent_count": 45,
    "cost_aware_default_active_agents": 1,
    "cost_aware_enterprise_active_agents": 8,
    "activation_policy": "cost_aware_core_subset_and_route_specialists_on_demand",
    "coordination": "distributed",
    "consensus": "majority",
    "anti_drift": true
  },
  "generated_project_ruflo_strategy": {
    "inheritance_mode": "solution_runtime",
    "available_agents": 60,
    "core_agents": 15,
    "specialist_agents": 45,
    "default_activation": "one_orchestrator_first",
    "standard_activation_limit": 3,
    "enterprise_activation_limit": 8,
    "full_activation_requires": [
      "explicit_high_complexity_request",
      "human_approval",
      "cost_budget_review",
      "role_specific_context_filtering"
    ],
    "recommended_fleets_by_universe": {
      "ml": ["ml_fleet", "data_fleet", "quality_fleet"],
      "ia": ["rag_fleet", "mcp_fleet", "security_fleet"],
      "chatbolt": ["rag_fleet", "mcp_fleet", "quality_fleet"],
      "hybrid": ["project_factory_fleet", "ml_fleet", "rag_fleet", "cost_optimization_fleet"]
    },
    "context_policy": "send_only_role_specific_context",
    "local_model_policy": "ollama_local_first",
    "inherited_artifacts": [
      "config/agent_fleets.json",
      "config/agent_trust_framework.json",
      "config/cost_optimization_policy.json",
      "config/model_providers.json",
      "scripts/start_ruflo_swarm.ps1",
      "agents/definitions/enterprise_agents.yaml"
    ]
  },
  "cost_optimization": {
    "enabled": true,
    "policy_file": "config/cost_optimization_policy.json",
    "default_profile": "standard",
    "activate_all_60_requires_explicit_high_complexity": true,
    "prefer_prompt_cache": true,
    "prefer_semantic_cache": true,
    "compress_context_before_llm": true,
    "send_only_role_specific_context": true
  },
  "local_llm": {
    "enabled": true,
    "provider": "ollama",
    "routing_strategy": "local_first",
    "default_model": "qwen2.5-coder:3b",
    "general_model": "qwen3:8b",
    "balanced_model": "deepseek-coder-v2:lite",
    "code_review_model": "deepseek-coder-v2:lite",
    "code_strong_model": "qwen2.5-coder:14b",
    "planning_strong_model": "qwen3:14b",
    "reasoning_strong_model": "deepseek-r1:14b",
    "code_critical_model": "qwen2.5-coder:32b",
    "large_model": "qwen2.5-coder:32b",
    "embedding_model": "nomic-embed-text:latest",
    "model_selection": "offline_profile_router",
    "model_profiles": {
      "fast": "qwen2.5-coder:3b",
      "general": "qwen3:8b",
      "balanced": "deepseek-coder-v2:lite",
      "code_review": "deepseek-coder-v2:lite",
      "code_strong": "qwen2.5-coder:14b",
      "planning_strong": "qwen3:14b",
      "reasoning_strong": "deepseek-r1:14b",
      "code_critical": "qwen2.5-coder:32b",
      "large": "qwen2.5-coder:32b",
      "embeddings": "nomic-embed-text:latest"
    },
    "allowed_local_models": [
      "nomic-embed-text:latest",
      "qwen2.5-coder:3b",
      "qwen3:8b",
      "deepseek-coder-v2:lite",
      "qwen2.5-coder:14b",
      "qwen3:14b",
      "deepseek-r1:14b",
      "qwen2.5-coder:32b"
    ],
    "large_model_requires_explicit_request": true,
    "recommended_context_tokens_on_16gb_ram": 4096,
    "provider_config_file": "config/model_providers.json",
    "vscode_test_script": "scripts/test_local_llm.py",
    "hybrid_router": "backend/app/services/hybrid_llm_router.py",
    "routing_endpoint": "/llm/generate",
    "metrics_endpoint": "/llm/metrics",
    "sensitive_content_local_only": true,
    "ruflo_governed_bridge": "backend/app/services/governed_swarm_execution.py",
    "ruflo_shared_memory_namespace": "synapse-governed-execution",
    "all_60_agents_model_access": "governed_on_demand"
    ,
    "cloud_default_enabled": false,
    "cloud_requires_human_approval": true,
    "default_max_output_tokens": 512,
    "default_context_window": 4096,
    "deterministic_seed": 42,
    "default_temperature": 0.0
  },
  "continual_learning": {
    "enabled": true,
    "mode": "memory_retrieval_first",
    "automatic_weight_updates": false,
    "events_path": "memory/synapse_learning_memory.jsonl",
    "training_dataset_path": "data/learning/ollama_training.jsonl",
    "feedback_endpoint": "/learning/feedback",
    "summary_endpoint": "/learning/summary",
    "promotion_requires_evals_and_human_approval": true
  },
  "business_transformation": {
    "enabled": true,
    "config_file": "config/business_transformation.json",
    "prompt_file": "prompts/business_transformation.md",
    "workflow_file": "config/workflows/ruflo/business-transformation.json",
    "agent_profiles_file": "agents/definitions/business_transformation_agents.yaml",
    "simulation_first": true,
    "human_approval_levels": ["HIGH", "CRITICAL"],
    "inherited_by_generated_projects": true
  },
  "memory": {
    "enabled": true,
    "namespace": "synapse-ai",
    "persist_on_create": true,
    "runtime_file": "memory/project_memory.runtime.json",
    "shared_dialog_memory": ".adonex/memory/SHARED_DIALOG_MEMORY.md",
    "chat_tasks": ".adonex/memory/CHAT_TASKS.md",
    "peer_messaging_server": "synapse-peers",
    "shared_by": [
      "vscode-chat",
      "codex",
      "claude-code",
      "adonex"
    ],
    "backend": "hybrid",
    "tiers": [
      "working",
      "episodic",
      "semantic"
    ],
    "embeddings": {
      "enabled": true,
      "dimension": 384,
      "provider": "ruflo-agentdb"
    },
    "semantic_search": {
      "enabled": true,
      "index": "hnsw-ready"
    },
    "vector_db_path": "vector_db"
  },
  "assistant_channels": {
    "enabled": true,
    "authorized_user_request_channels": [
      "VS Code Chat",
      "AdoneX",
      "Claude Code",
      "Codex"
    ],
    "content_collection_rule": "Goals, constraints, files, decisions, approvals and missing briefing fields for corporate solution creation must be collected or confirmed through assistant chat channels before using tasks, scripts, browser UI or tools.",
    "shared_solution_factory_access": {
      "policy": "config/llm_solution_factory_policy.json",
      "technology_catalog": "config/ai_framework_selection.json",
      "business_analyzer": "backend/app/services/business_solution_analyzer.py",
      "analyzer_cli": "scripts/analyze_business_solution.py",
      "governance": "docs/specifications/llm_solution_factory_governance.md",
      "technology_layer": "docs/specifications/technology_layer.md",
      "ml_foundations_policy": "config/ml_foundations_policy.json",
      "ml_foundations_spec": "docs/specifications/ml_foundations.md",
      "shared_dialog_memory": ".adonex/memory/SHARED_DIALOG_MEMORY.md",
      "chat_tasks": ".adonex/memory/CHAT_TASKS.md",
      "peer_mailbox": "synapse-peers",
      "tests": "tests",
      "evals": "evals"
    },
    "non_primary_channels": [
      "VS Code tasks",
      "browser UI",
      "scripts",
      "MCP tools"
    ],
    "non_primary_channel_rule": "Use non-primary channels only as execution, validation, scaffolding or tool shortcuts after chat has collected or confirmed the required user content."
  },
  "rag": {
    "ready": true,
    "implementation_status": "local_executable",
    "runtime": "backend/app/rag/pipeline.py",
    "api_prefix": "/rag",
    "limitations": [
      "local lexical/vector-light index is intended for project bootstrap and offline evaluation",
      "production vector store integration is still optional by adapter",
      "GraphRAG remains a governed advanced strategy, not the default retrieval path"
    ],
    "advanced_strategies": [
      "multi_query_retrieval",
      "hybrid_search",
      "semantic_search",
      "reranking",
      "context_compression",
      "parent_child_retrieval",
      "graph_rag",
      "metadata_filtering"
    ],
    "pipeline": [
      "ingest",
      "normalize",
      "chunk",
      "embed",
      "index",
      "retrieve",
      "rerank",
      "cite"
    ]
  },
  "engineering_practices": {
    "playbooks_path": "playbooks",
    "prompt_registry_path": "prompts",
    "evals_path": "evals",
    "llm_ops_path": "llm_ops",
    "ml_systems_path": "ml_systems",
    "rag_pipelines_path": "rag_pipelines",
    "guardrails_path": "guardrails",
    "foundations_notebooks_path": "notebooks/foundations",
    "book_map": "docs/books/implementation_map.md"
  },
