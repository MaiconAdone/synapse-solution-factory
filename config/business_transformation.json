{
  "version": 1,
  "name": "synapse-agentic-business-transformation",
  "purpose": "Transform business objectives into governed, measurable and executable agentic workflows.",
  "conceptual_foundations": [
    "agents pursue business objectives and produce auditable actions",
    "AI is an operational layer connecting data, processes, tools and decisions",
    "business processes are redesigned before automation is scaled",
    "stateful workflows separate reasoning, decision, execution and validation",
    "human authority increases with risk and irreversibility",
    "business value, adoption and operational learning are measured continuously"
  ],
  "workflow": {
    "id": "business-transformation",
    "stateful": true,
    "simulation_first": true,
    "stages": [
      "intake",
      "diagnosis",
      "process_mapping",
      "opportunity_identification",
      "prioritization",
      "execution_planning",
      "risk_governance",
      "human_approval",
      "simulation",
      "impact_evaluation"
    ]
  },
  "autonomy": {
    "LOW": "automatic_with_audit",
    "MEDIUM": "automatic_with_validation_and_audit",
    "HIGH": "human_approval_required",
    "CRITICAL": "explicit_human_approval_and_no_external_automatic_action"
  },
  "functional_agents": [
    {"id": "orchestrator", "class": "OrchestratorAgent", "agent_id": "orchestration-manager"},
    {"id": "business_transformation", "class": "BusinessTransformationAgent", "agent_id": "product-strategy"},
    {"id": "process_mapping", "class": "ProcessMappingAgent", "agent_id": "business-value-analyst"},
    {"id": "data_analysis", "class": "DataAnalysisAgent", "agent_id": "data-science"},
    {"id": "automation_architect", "class": "AutomationArchitectAgent", "agent_id": "integration-automation"},
    {"id": "kpi_monitor", "class": "KPIMonitorAgent", "agent_id": "metrics-instrumentation"},
    {"id": "risk_governance", "class": "RiskGovernanceAgent", "agent_id": "security-compliance"},
    {"id": "human_approval", "class": "HumanApprovalAgent", "agent_id": "policy-guardrails-engineer"}
  ],
  "initial_business_areas": [
    "sales",
    "marketing",
    "customer_service",
    "logistics",
    "finance",
    "human_resources",
    "management"
  ],
  "required_business_metrics": [
    "cycle_time",
    "rework_rate",
    "cost_per_case",
    "primary_business_outcome",
    "adoption_rate"
  ],
  "framework_policy": {
    "current_engine": "typed_python_state_machine",
    "langgraph_when": "durable checkpoints, cycles, distributed resume or complex handoffs are required",
    "langchain_when": "a maintained chain, retriever or integration component reduces implementation risk",
    "mcp_required_for_external_tools": true,
    "swarm_control_plane": true
  }
}
